POSTGRES_DB=vigia
POSTGRES_USER=vigia
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=replace-me

# Discord webhook per notification channel, keyed by the channel name given to
# `create-channel`. Kept out of the database deliberately: a dump must not carry
# the ability to post to your Discord.
# Notifier__ChannelWebhooks__ops=https://discord.com/api/webhooks/...

# The application's database role. Deliberately not POSTGRES_USER: that is the
# bootstrap superuser the postgres image creates, and PostgreSQL will not let
# you remove SUPERUSER from it. A superuser connection means COPY FROM PROGRAM —
# command execution inside the database container — for anyone who reaches this
# file or the container's environment. Create the role once, give it ownership
# of the tables so partition maintenance still works, and connect as that:
#
#   CREATE ROLE vigia_app LOGIN PASSWORD '...' NOSUPERUSER NOCREATEDB NOCREATEROLE;
#   -- then transfer ownership of every table and sequence in public to it,
#   -- and GRANT ALL ON SCHEMA public TO vigia_app;
VIGIA_DB_USER=vigia_app
VIGIA_DB_PASSWORD=
