{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "Queue": {
    "Capacity": 32,
    "EnqueueTimeoutMilliseconds": 250,
    "RetryAfterSeconds": 1
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "Ingestion": {
    "MaxBatchPoints": 5000,
    "FlushIntervalMilliseconds": 1000,
    "ShutdownDrainMilliseconds": 10000
  },
  "Maintenance": {
    "WeeksAhead": 3,
    "RawRetentionDays": 7,
    "IntervalMinutes": 60
  },
  "Alerting": {
    "IntervalSeconds": 30
  },
  "Notifier": {
    "IntervalSeconds": 10,
    "BatchSize": 20,
    "MaxAttempts": 8,
    "MaxOutboxRows": 5000
  },
  "AllowedHosts": "*"
}
